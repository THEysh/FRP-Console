{
  "name": "frp-console",
  "productName": "FRP控制台",
  "version": "1.2.85",
  "description": "FRP 内网穿透图形控制台：代理管理、本机端口扫描、frps 远程管理、热重载与实时日志",
  "main": "src/main/index.js",
  "author": "杨盛晖",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/THEysh/FRP-Console.git"
  },
  "homepage": "https://github.com/THEysh/FRP-Console",
  "bugs": {
    "url": "https://github.com/THEysh/FRP-Console/issues"
  },
  "keywords": [
    "frp",
    "frpc",
    "frps",
    "electron",
    "内网穿透",
    "反向代理",
    "windows"
  ],
  "scripts": {
    "start": "node tools/dev.cjs",
    "dev": "node tools/dev.cjs",
    "dev:raw": "electron .",
    "dist": "node tools/fetch-frpc.cjs && electron-builder --win nsis --x64 && node tools/after-build.cjs",
    "dist:portable": "node tools/fetch-frpc.cjs && electron-builder --win portable --x64 && node tools/after-build.cjs",
    "dist:dir": "node tools/fetch-frpc.cjs && electron-builder --win dir --x64 && node tools/after-build.cjs",
    "fetch:frpc": "node tools/fetch-frpc.cjs",
    "tray-icons": "node tools/make-tray-icons.cjs"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "acme-client": "^5.4.0",
    "electron-updater": "^6.8.11",
    "smol-toml": "^1.9.1",
    "ssh2": "^1.16.0"
  },
  "devDependencies": {
    "electron": "31.7.7",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "cn.ysh.frp-console",
    "productName": "FRP控制台",
    "executableName": "FRP-Console",
    "publish": [
      {
        "provider": "github",
        "owner": "THEysh",
        "repo": "FRP-Console"
      }
    ],
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "src/**/*",
      "assets/*.png",
      "assets/*.ico",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "vendor/frpc",
        "to": "frpc",
        "filter": [
          "frpc.exe"
        ]
      }
    ],
    "asar": true,
    "npmRebuild": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "FRP-Console-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "runAfterFinish": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "FRP 控制台",
      "artifactName": "FRP-Console-Setup-${version}-${arch}.${ext}",
      "include": "build/installer.nsh",
      "deleteAppDataOnUninstall": false,
      "uninstallDisplayName": "FRP 控制台"
    },
    "portable": {
      "artifactName": "FRP-Console-${version}.${ext}",
      "requestExecutionLevel": "user"
    },
    "compression": "normal"
  }
}
