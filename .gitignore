# 依赖与构建产物
node_modules/
npm-debug.log*
dist/
dist-new/
dist-*/
.build-test*/
.npm-cache/

# 运行期数据（便携版会在 exe 同级生成）
frp-console-data/
frp-console-backups/
# 源码模式在受限会话（如 DSH 沙箱）里的开发数据目录
.frp-console-data/

# 本机常驻的 frpc 运行时（frpc.exe + 含 token 的 frpc.toml，绝不入库）
runtime/

# 打包前自动下载的 frpc.exe（18 MB，由 tools/fetch-frpc.cjs 现取现用）
vendor/frpc/

# 本地日志与临时文件
*.log
*.tmp
*.bak
Thumbs.db
desktop.ini

# 编辑器 / 工具
.vscode/
.idea/
.workbuddy/
# UI 自动化截图输出
.shots/
# 截图演示用的隔离数据目录
.demo/
# 端到端回归用的隔离沙箱（临时 settings/frpc.toml，绝不入库）
.e2e/
# E2E 跑批时的一次性数据目录（tests/e2e/run.cjs 生成）
.e2e-tmp/

# 打包时的工作目录残留
__pycache__/
